<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#0A0E17">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Control Panel"
        android:textColor="#E2E8F0"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/et_relay_url"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Relay Server URL"
        android:textColorHint="#475569"
        android:textColor="#E2E8F0"
        android:background="@drawable/edittext_bg"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:inputType="textUri" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/et_device_id"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Device ID"
            android:textColorHint="#475569"
            android:textColor="#E2E8F0"
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_copy_id"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Copy ID"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Start Service"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Stop"
            android:textColor="#E2E8F0"
            android:backgroundTint="#1E2D3D"
            android:enabled="false" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_permissions"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="Grant Permissions"
        android:textColor="#E2E8F0"
        android:backgroundTint="#1E2D3D" />

    <Button
        android:id="@+id/btn_notif_listener"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="Enable Notification Listener"
        android:textColor="#E2E8F0"
        android:backgroundTint="#1E2D3D" />

    <Button
        android:id="@+id/btn_autostart"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="OEM Auto-Start / No Restriction"
        android:textColor="#E2E8F0"
        android:backgroundTint="#1E2D3D" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_hide_icon"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Hide Icon"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7C3AED"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_show_icon"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Show Icon"
            android:textColor="#E2E8F0"
            android:backgroundTint="#1E2D3D" />

    </LinearLayout>


    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Service: STOPPED"
        android:textColor="#EF4444"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
