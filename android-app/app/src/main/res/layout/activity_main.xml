<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0A0E17">

    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="DeviceBridge"
        android:src="@drawable/ic_launcher_foreground"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DeviceBridge"
        android:textColor="#3B82F6"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remote Device Control"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btn_play"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="▶  Play Bridge Master"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3B82F6"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_open_control"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="⚙  Control Panel"
        android:textColor="#E2E8F0"
        android:backgroundTint="#1E2D3D" />

</LinearLayout>
